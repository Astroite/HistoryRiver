{
  "name": "luo-jiu-chuan-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "data:build": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-history-data.ts",
    "data:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-history-data.ts --check",
    "typecheck": "tsc --noEmit",
    "test:model": "node --experimental-strip-types --test tests/history-model.test.ts",
    "test:camera": "node --experimental-strip-types --test tests/river-camera-controls.test.ts",
    "test": "npm run data:check && npm run typecheck && npm run test:model && npm run test:camera && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
